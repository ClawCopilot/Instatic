{
  "name": "@instatic/plugin-social-login",
  "version": "0.1.0",
  "description": "Social login bridges: Google, GitHub, Apple, WeChat. Auto-creates public_users on first social login, links to OIDC provider for token issuance.",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir=dist --external @instatic/*"
  },
  "keywords": ["instatic", "plugin", "social-login", "oauth", "google", "github", "apple", "wechat"],
  "license": "MIT",
  "instaticManifest": {
    "id": "instatic.social-login",
    "name": "Social Login",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "Social login bridges. Auto-provisions public_users from Google/GitHub/Apple/WeChat identity, then redirects into the OIDC authorize flow.",
    "permissions": [
      "cms.migrations",
      "cms.routes",
      "cms.routes.public",
      "cms.publicRoutes",
      "network.outbound",
      "cms.hooks",
      "cms.db"
    ],
    "entrypoints": {
      "server": "dist/index.js"
    },
    "resources": [],
    "adminPages": [],
    "settings": [
      {
        "id": "googleClientId",
        "type": "text",
        "label": "Google OAuth client ID",
        "required": false,
        "default": ""
      },
      {
        "id": "googleClientSecret",
        "type": "text",
        "label": "Google OAuth client secret",
        "secret": true,
        "default": ""
      },
      {
        "id": "githubClientId",
        "type": "text",
        "label": "GitHub OAuth app client ID",
        "required": false,
        "default": ""
      },
      {
        "id": "githubClientSecret",
        "type": "text",
        "label": "GitHub OAuth app client secret",
        "secret": true,
        "default": ""
      },
      {
        "id": "appleClientId",
        "type": "text",
        "label": "Apple Sign-In client ID (Services ID)",
        "required": false,
        "default": ""
      },
      {
        "id": "appleTeamId",
        "type": "text",
        "label": "Apple Developer Team ID",
        "required": false,
        "default": ""
      },
      {
        "id": "appleKeyId",
        "type": "text",
        "label": "Apple private key ID",
        "required": false,
        "default": ""
      },
      {
        "id": "applePrivateKey",
        "type": "text",
        "label": "Apple private key (PEM, with newlines)",
        "required": false,
        "secret": true,
        "default": ""
      },
      {
        "id": "wechatAppId",
        "type": "text",
        "label": "WeChat Open Platform AppID",
        "required": false,
        "default": ""
      },
      {
        "id": "wechatAppSecret",
        "type": "text",
        "label": "WeChat AppSecret",
        "secret": true,
        "default": ""
      },
      {
        "id": "enabledProviders",
        "type": "text",
        "label": "Enabled providers (comma-separated)",
        "description": "e.g. 'google,github' — only listed providers will accept callbacks.",
        "default": "google,github"
      }
    ],
    "networkAllowedHosts": [
      "accounts.google.com",
      "oauth2.googleapis.com",
      "github.com",
      "api.github.com",
      "appleid.apple.com",
      "openapi.work.weixin.qq.com"
    ],
    "dependencies": {
      "plugins": ["public-auth", "oidc-provider"]
    }
  }
}