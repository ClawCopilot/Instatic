{
  "name": "@instatic/content-assistant",
  "version": "0.1.0",
  "description": "AI-powered content creation assistant — rewrite, expand, and SEO-optimize CMS content.",
  "instaticManifest": {
    "id": "instatic.content-assistant",
    "name": "Content Assistant",
    "version": "0.1.0",
    "apiVersion": 1,
    "description": "AI-powered content creation assistant for rewriting, expanding, and SEO-optimizing CMS content.",
    "permissions": [
      "cms.routes.public"
    ],
    "entrypoints": {
      "server": "dist/index.js"
    },
    "resources": [],
    "adminPages": [],
    "settings": [
      {
        "id": "tone",
        "label": "Writing Tone",
        "type": "select",
        "options": [
          { "value": "professional", "label": "Professional" },
          { "value": "casual", "label": "Casual" },
          { "value": "friendly", "label": "Friendly" },
          { "value": "academic", "label": "Academic" }
        ],
        "default": "professional"
      },
      {
        "id": "targetLanguage",
        "label": "Target Language",
        "type": "select",
        "options": [
          { "value": "zh", "label": "Chinese" },
          { "value": "en", "label": "English" },
          { "value": "ja", "label": "Japanese" },
          { "value": "ko", "label": "Korean" }
        ],
        "default": "zh"
      }
    ]
  }
}
